# =============================================================================
# AS_Telegram — plantilla de variables de entorno
# Copiar a .env y completar LOCALMENTE. Nunca publicar .env ni *.session.
# La extracción directa por API es OPCIONAL: el sistema funciona con un export
# local (data/raw/result.json) y sin credenciales.
# =============================================================================

# --- Extracción opcional por Telethon/API (NO requerida) ---------------------
# Obtener en https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_PHONE=+591XXXXXXXX
TG_SESSION=anon
TG_CHAT_ID=
