# =============================================================================
# AS_Telegram — archivos excluidos de Git
# =============================================================================

# --- Secretos y sesiones ----------------------------------------------------
.env
*.session
*.session-journal
.credentials*

# --- Corpus y datos (privados / generados localmente) ----------------------

# --- Base de datos local ----------------------------------------------------
database/*.sqlite
database/*.sqlite-*
database/*.db

# --- Resultados privados y artefactos no reproducibles ----------------------
reports/figures/*
reports/tables/*
reports/generated/*
!reports/figures/.gitkeep
!reports/tables/.gitkeep
!reports/generated/.gitkeep

# --- Compilación LaTeX ------------------------------------------------------
reports/*.pdf
reports/*.aux
reports/*.log
reports/*.out
reports/*.toc
reports/*.synctex.gz
reports/*.fls
reports/*.fdb_latexmk
reports/*.bbl
reports/*.blg

# --- Logs -------------------------------------------------------------------
logs/*
!logs/.gitkeep

# --- Configuración local ----------------------------------------------------
config/config.yml

# --- renv -------------------------------------------------------------------
renv/library/
renv/staging/
renv/cache/
renv/sandbox/

# --- R / herramientas -------------------------------------------------------
.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.Rproj

# --- Temporales -------------------------------------------------------------
_*.R
_*.sh
_*.log
*.tmp
*.bak
__pycache__/
*.pyc
venv/
.venv/

# --- Sistema -----------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/*.log
ChatExport/

